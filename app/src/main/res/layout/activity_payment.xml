<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/brand_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- شريط علوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back_button" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/payment_title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <View android:layout_width="32dp" android:layout_height="32dp" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_subtitle"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="6dp" />

        <!-- بطاقة 1: مجاني -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_plan_card_free"
            android:padding="16dp"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/plan_free_name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/current_plan_badge"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <TextView style="@style/PlanFeatureText" android:text="@string/plan_free_feature_one" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_free_feature_two" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_free_feature_three" />

        </LinearLayout>

        <!-- بطاقة 2: اشتراك فهيم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/plan_regular_name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_regular_trial_badge"
                    android:textColor="@color/brand_primary_green"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_light"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <TextView style="@style/PlanFeatureText" android:text="@string/plan_regular_feature_one" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_regular_feature_two" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_regular_feature_three" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_regular_feature_four" />

            <Button
                android:id="@+id/startTrialButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/start_trial_button"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_rounded" />

        </LinearLayout>

        <!-- بطاقة 3: بريميوم -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_plan_card_premium"
            android:padding="16dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/plan_premium_name"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/plan_premium_badge"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:background="@drawable/bg_pill_gold"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/plan_premium_price"
                android:textStyle="bold"
                android:textSize="22sp"
                android:textColor="@color/brand_terracotta"
                android:layout_marginTop="6dp" />

            <TextView style="@style/PlanFeatureText" android:text="@string/plan_premium_feature_one" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_premium_feature_two" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_premium_feature_three" />
            <TextView style="@style/PlanFeatureText" android:text="@string/plan_premium_feature_four" />

            <Button
                android:id="@+id/subscribePremiumButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="14dp"
                android:text="@string/subscribe_premium_button"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_button_gold" />

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel_anytime_note"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:gravity="center"
            android:layout_marginBottom="20dp" />

    </LinearLayout>
</ScrollView>