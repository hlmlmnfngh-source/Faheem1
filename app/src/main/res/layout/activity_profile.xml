<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/brand_bg"
    android:layoutDirection="rtl"
    android:fitsSystemWindows="true"
    tools:context=".ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- شريط علوي -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/backButton"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_back"
                android:contentDescription="@string/back_button" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/profile_title"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/text_primary"
                android:gravity="center" />

            <View android:layout_width="32dp" android:layout_height="32dp" />

        </LinearLayout>

        <!-- صورة المستخدم مع زر الإضافة (دائرية) -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/userProfileImage"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:background="@drawable/bg_icon_circle"
                android:contentDescription="@string/user_avatar"
                android:padding="2dp"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_launcher"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:shapeAppearanceOverlay="@style/CircleImage" />

            <ImageView
                android:id="@+id/editProfileImageButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_paw_badge"
                android:padding="10dp"
                android:src="@drawable/ic_add"
                android:elevation="8dp"
                app:layout_constraintBottom_toBottomOf="@id/userProfileImage"
                app:layout_constraintEnd_toEndOf="@id/userProfileImage"
                android:translationX="4dp"
                android:translationY="4dp"
                android:contentDescription="@string/edit_profile_image" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/userNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_user_name"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/text_primary"
            android:gravity="center"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/userEmailText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sample_user_email"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:layout_marginTop="4dp" />

        <!-- بطاقة الاشتراك -->
        <LinearLayout
            android:id="@+id/upgradeCardLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/card_bg"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/planText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/current_plan_free"
                android:textColor="@color/text_primary"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/upgrade_link"
                android:textColor="@color/brand_terracotta"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- عنوان حيواناتي + زر إضافة -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="32dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/my_pets_title"
                android:textStyle="bold"
                android:textSize="17sp"
                android:textColor="@color/text_primary" />

            <ImageView
                android:id="@+id/addPetButton"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_add"
                android:contentDescription="@string/add_pet_button" />

        </LinearLayout>

        <!-- قائمة أفقية للحيوانات -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:scrollbars="none"
            android:layoutDirection="ltr">

            <LinearLayout
                android:id="@+id/petsContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="8dp">

                <!-- بطاقات الحيوانات تُضاف من الكود -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- قائمة الخيارات -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:id="@+id/settingsRow"
                style="@style/ProfileMenuRow">
                <TextView style="@style/ProfileMenuText" android:text="@string/menu_settings" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/historyRow"
                style="@style/ProfileMenuRow">
                <TextView style="@style/ProfileMenuText" android:text="@string/menu_history" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/termsRow"
                style="@style/ProfileMenuRow">
                <TextView style="@style/ProfileMenuText" android:text="@string/menu_terms" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/privacyRow"
                style="@style/ProfileMenuRow">
                <TextView style="@style/ProfileMenuText" android:text="@string/menu_privacy" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/contactRow"
                style="@style/ProfileMenuRow">
                <TextView style="@style/ProfileMenuText" android:text="@string/menu_contact" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/logoutRow"
                style="@style/ProfileMenuRow"
                android:layout_marginBottom="24dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/menu_logout"
                    android:textColor="#D64545"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>