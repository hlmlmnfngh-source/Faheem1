<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/brand_bg">

    <View
        android:id="@+id/logo_bg_outer"
        android:layout_width="240dp"
        android:layout_height="240dp"
        android:background="@drawable/circle_bg"
        android:elevation="4dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.3" />

    <View
        android:id="@+id/logo_bg_inner"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:background="@drawable/circle_bg"
        android:backgroundTint="@color/brand_sand"
        android:elevation="5dp"
        app:layout_constraintBottom_toBottomOf="@id/logo_bg_outer"
        app:layout_constraintEnd_toEndOf="@id/logo_bg_outer"
        app:layout_constraintStart_toStartOf="@id/logo_bg_outer"
        app:layout_constraintTop_toTopOf="@id/logo_bg_outer" />

    <ImageView
        android:id="@+id/logo_icon"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:elevation="6dp"
        android:src="@drawable/ic_faheem_cat_outline"
        app:layout_constraintBottom_toBottomOf="@id/logo_bg_inner"
        app:layout_constraintEnd_toEndOf="@id/logo_bg_inner"
        app:layout_constraintStart_toStartOf="@id/logo_bg_inner"
        app:layout_constraintTop_toTopOf="@id/logo_bg_inner" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="48sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logo_bg_outer" />

    <TextView
        android:id="@+id/tv_app_desc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/app_description"
        android:textColor="@color/text_secondary"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_app_name" />

    <LinearLayout
        android:id="@+id/dot_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@id/tv_version"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#D1D1D1" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="#D1D1D1" />

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_margin="4dp"
            android:background="@drawable/circle_bg"
            android:backgroundTint="@color/brand_primary_green" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="48dp"
        android:text="@string/version_text"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>